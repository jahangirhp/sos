<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl" android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/BodyText" android:text="@string/app_name" android:textSize="30sp" android:textStyle="bold" android:textColor="#252823" />
        <TextView style="@style/BodyText" android:text="@string/tagline" android:layout_marginTop="4dp" />
        <Button android:id="@+id/send" android:layout_width="match_parent" android:layout_height="148dp"
            android:layout_marginTop="24dp" android:background="@drawable/sos_button" android:backgroundTint="@null"
            android:text="@string/send_sos" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold"
            android:stateListAnimator="@null" android:elevation="0dp" />
        <TextView style="@style/BodyText" android:text="@string/profile_privacy" android:layout_marginTop="12dp" android:textSize="13sp" />
        <TextView android:id="@+id/status" style="@style/BodyText" android:text="@string/status_initial"
            android:textColor="#315B46" android:layout_marginTop="20dp" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/connect" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/connect" android:textColor="#315B46" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="12dp" android:padding="16dp" android:background="@drawable/panel">
            <TextView style="@style/BodyText" android:text="@string/alerts_title" android:textSize="18sp" android:textStyle="bold" android:textColor="#252823" />
            <TextView android:id="@+id/alerts" style="@style/BodyText" android:text="@string/no_alerts" android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <Button android:id="@+id/sound_settings" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="12dp" android:text="@string/settings" android:textColor="#64645F" />
        <TextView style="@style/BodyText" android:text="@string/keep_open" android:textSize="13sp" />
        <TextView style="@style/BodyText" android:text="@string/notice" android:textSize="12sp" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
